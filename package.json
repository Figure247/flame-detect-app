{
  "name": "flame-detect-app",
  "version": "2.0.0",
  "description": "YOLOv8 火焰检测系统 - 桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir"
  },
  "author": "FlameDetect",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.flamedetect.app",
    "productName": "FlameDetect Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "main.py",
      "start_backend.py",
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "backend.exe",
        "to": "backend.exe"
      },
      {
        "from": "main.py",
        "to": "main.py"
      },
      {
        "from": "start_backend.py",
        "to": "start_backend.py"
      },
      {
        "from": "data/models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "FlameDetect",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlameDetect Pro",
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "fix-webm-duration": "^1.0.6"
  }
}
